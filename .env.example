# Copie para .env e preencha. Nunca faça commit do .env.

# Apps (públicas)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Servidor (Edge Functions do Supabase): `supabase secrets set NOME=valor`, nunca no app.
# SUPABASE_URL, SUPABASE_ANON_KEY e SUPABASE_SERVICE_ROLE_KEY já vêm prontas nas Edge Functions.
LLM_API_KEY=
# Opcionais
LLM_MODEL=claude-haiku-5-5
LLM_MODEL_VISAO=claude-sonnet-5-5
NOME_ASSISTENTE=Lia
